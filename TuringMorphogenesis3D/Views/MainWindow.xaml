<Window x:Class="TuringMorphogenesis3D.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:vm="clr-namespace:TuringMorphogenesis3D.ViewModels"
        xmlns:helpers="clr-namespace:TuringMorphogenesis3D.Helpers"
        Title="{Binding Loc[AppTitle]}"
        Width="1280" Height="780"
        MinWidth="980" MinHeight="620"
        Background="{StaticResource BgBaseBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <helpers:PhaseXConverter x:Key="PhaseXConverter"/>
        <helpers:PhaseYConverter x:Key="PhaseYConverter"/>
        <helpers:PanelWidthConverter x:Key="PanelWidth"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SideTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Margin="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                                <Setter TargetName="bd" Property="TextElement.Foreground" Value="{StaticResource TextAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Margin="6,6,6,4"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ToggleRunCommand}"/>
        <KeyBinding Key="F6" Command="{Binding ResetCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding TogglePresentationCommand}"/>
    </Window.InputBindings>

    <Border x:Name="RootBorder"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК -->
            <Grid Grid.Row="0" Background="{StaticResource BgTitleBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Margin="14,0,0,0" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="🧬" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Loc[AppTitle]}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" FontFamily="{StaticResource UIFont}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" Background="Transparent"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="◧" Command="{Binding TogglePanelCommand}"
                            Style="{StaticResource LangButton}"
                            ToolTip="{Binding Loc[TipTogglePanel]}"/>
                    <Button Content="⛶" Command="{Binding TogglePresentationCommand}"
                            Style="{StaticResource LangButton}"
                            ToolTip="{Binding Loc[BtnPresent]}"/>
                    <Button Content="{Binding Loc[BtnLanguage]}"
                            Command="{Binding ToggleLanguageCommand}"
                            Style="{StaticResource LangButton}"/>
                    <Button x:Name="MinimizeButton" Content="&#xE921;"
                            Style="{StaticResource CaptionButton}"
                            Click="MinimizeButton_Click" ToolTip="{Binding Loc[TipMinimize]}"/>
                    <Button x:Name="MaximizeButton" Content="&#xE922;"
                            Style="{StaticResource CaptionButton}"
                            Click="MaximizeButton_Click" ToolTip="{Binding Loc[TipMaximize]}"/>
                    <Button x:Name="CloseButton" Content="&#xE8BB;"
                            Style="{StaticResource CloseCaptionButton}"
                            Click="CloseButton_Click" ToolTip="{Binding Loc[TipClose]}"/>
                </StackPanel>
            </Grid>

            <!-- СОДЕРЖИМОЕ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding IsPanelVisible, Converter={StaticResource PanelWidth}}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ ПАНЕЛЬ С ВКЛАДКАМИ -->
                <Border Grid.Column="0"
                        Visibility="{Binding PanelVisibility}"
                        Background="{StaticResource BgPanelBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0">
                    <TabControl Style="{StaticResource SideTabControl}">

                        <TabItem Header="{Binding Loc[TabSim]}" Style="{StaticResource SideTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="12,8,12,10">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[HeaderControl]}" Style="{StaticResource SectionHeader}"/>
                                            <UniformGrid Columns="2">
                                                <Button Content="{Binding Loc[BtnStart]}" Command="{Binding StartCommand}" Style="{StaticResource StartButton}"/>
                                                <Button Content="{Binding Loc[BtnStop]}" Command="{Binding StopCommand}" Style="{StaticResource StopButton}"/>
                                                <Button Content="{Binding Loc[BtnReset]}" Command="{Binding ResetCommand}" Style="{StaticResource ActionButton}"/>
                                                <Button Content="{Binding Loc[BtnRandom]}" Command="{Binding RandomizeCommand}" Style="{StaticResource ActionButton}"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[HeaderParameters]}" Style="{StaticResource SectionHeader}"/>
                                            <Grid>
                                                <TextBlock Text="{Binding Loc[LblFeed]}" Style="{StaticResource ParamLabel}"/>
                                                <TextBlock Text="{Binding FeedRate, StringFormat=F4}" Style="{StaticResource ParamValueText}"/>
                                            </Grid>
                                            <Slider Value="{Binding FeedRate}" Minimum="0.005" Maximum="0.085" Style="{StaticResource ModernSlider}"/>
                                            <Grid>
                                                <TextBlock Text="{Binding Loc[LblKill]}" Style="{StaticResource ParamLabel}"/>
                                                <TextBlock Text="{Binding KillRate, StringFormat=F4}" Style="{StaticResource ParamValueText}"/>
                                            </Grid>
                                            <Slider Value="{Binding KillRate}" Minimum="0.025" Maximum="0.085" Style="{StaticResource ModernSlider}"/>
                                            <Grid>
                                                <TextBlock Text="{Binding Loc[LblDu]}" Style="{StaticResource ParamLabel}"/>
                                                <TextBlock Text="{Binding DiffusionU, StringFormat=F3}" Style="{StaticResource ParamValueText}"/>
                                            </Grid>
                                            <Slider Value="{Binding DiffusionU}" Minimum="0.04" Maximum="0.20" Style="{StaticResource ModernSlider}"/>
                                            <Grid>
                                                <TextBlock Text="{Binding Loc[LblDv]}" Style="{StaticResource ParamLabel}"/>
                                                <TextBlock Text="{Binding DiffusionV, StringFormat=F3}" Style="{StaticResource ParamValueText}"/>
                                            </Grid>
                                            <Slider Value="{Binding DiffusionV}" Minimum="0.02" Maximum="0.12" Style="{StaticResource ModernSlider}"/>
                                            <Grid>
                                                <TextBlock Text="{Binding Loc[LblIterations]}" Style="{StaticResource ParamLabel}"/>
                                                <TextBlock Text="{Binding IterationsPerFrame}" Style="{StaticResource ParamValueText}"/>
                                            </Grid>
                                            <Slider Value="{Binding IterationsPerFrame}" Minimum="1" Maximum="32" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource ModernSlider}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{Binding Loc[TabPatterns]}" Style="{StaticResource SideTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="12,8,12,10">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[HeaderPresets]}" Style="{StaticResource SectionHeader}"/>
                                            <ItemsControl ItemsSource="{Binding PresetItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Label}"
                                                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Value}"
                                                                Style="{StaticResource PresetButton}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[HeaderCustomPresets]}" Style="{StaticResource SectionHeader}"/>
                                            <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{StaticResource BgInputBrush}"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                                     Padding="10,7" FontSize="12.5"/>
                                            <Button Content="{Binding Loc[BtnSavePreset]}"
                                                    Command="{Binding SavePresetCommand}"
                                                    Style="{StaticResource ActionButton}" Margin="0,6,0,6"/>
                                            <ItemsControl ItemsSource="{Binding UserPresets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Content="{Binding Name}"
                                                                    Command="{Binding DataContext.ApplyUserPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource PresetButton}"
                                                                    HorizontalContentAlignment="Left"/>
                                                            <Button Grid.Column="1" Content="✕" Width="30"
                                                                    Command="{Binding DataContext.DeleteUserPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{Binding Loc[TipDeletePreset]}"
                                                                    Style="{StaticResource PresetButton}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{Binding Loc[TabSurface]}" Style="{StaticResource SideTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="12,8,12,10">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[HeaderSurface]}" Style="{StaticResource SectionHeader}"/>
                                            <ComboBox ItemsSource="{Binding MeshItems}" ItemTemplate="{StaticResource LabelItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding SelectedMeshType}" Style="{StaticResource DarkCombo}"/>
                                            <TextBlock Text="{Binding Loc[HeaderGradient]}" Style="{StaticResource SectionHeader}" Margin="0,6,0,10"/>
                                            <ComboBox ItemsSource="{Binding GradientItems}" ItemTemplate="{StaticResource LabelItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding SelectedGradient}" Style="{StaticResource DarkCombo}"/>
                                            <TextBlock Text="{Binding Loc[HeaderColorScheme]}" Style="{StaticResource SectionHeader}" Margin="0,6,0,10"/>
                                            <ComboBox ItemsSource="{Binding SchemeItems}" ItemTemplate="{StaticResource LabelItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding SelectedColorScheme}" Style="{StaticResource DarkCombo}"/>
                                            <TextBlock Text="{Binding Loc[HeaderResolution]}" Style="{StaticResource SectionHeader}" Margin="0,6,0,10"/>
                                            <ComboBox ItemsSource="{Binding Resolutions}" ItemStringFormat="{}{0} × {0}" SelectedItem="{Binding GridResolution}" Style="{StaticResource DarkCombo}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[HeaderRender]}" Style="{StaticResource SectionHeader}"/>
                                            <Grid>
                                                <TextBlock Text="{Binding Loc[LblRelief]}" Style="{StaticResource ParamLabel}"/>
                                                <TextBlock Text="{Binding Relief, StringFormat=F2}" Style="{StaticResource ParamValueText}"/>
                                            </Grid>
                                            <Slider Value="{Binding Relief}" Minimum="0" Maximum="0.5" Style="{StaticResource ModernSlider}"/>
                                            <Grid>
                                                <TextBlock Text="{Binding Loc[LblGlow]}" Style="{StaticResource ParamLabel}"/>
                                                <TextBlock Text="{Binding Glow, StringFormat=F2}" Style="{StaticResource ParamValueText}"/>
                                            </Grid>
                                            <Slider Value="{Binding Glow}" Minimum="0" Maximum="1" Style="{StaticResource ModernSlider}"/>
                                            <CheckBox Content="{Binding Loc[LblAutoRotate]}" IsChecked="{Binding AutoRotate}" Style="{StaticResource ToggleSwitch}"/>
                                            <CheckBox Content="{Binding Loc[LblAutoRespawn]}" IsChecked="{Binding AutoRespawn}" Style="{StaticResource ToggleSwitch}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{Binding Loc[TabTools]}" Style="{StaticResource SideTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="12,8,12,10">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[ToolsHeader]}" Style="{StaticResource SectionHeader}"/>
                                            <CheckBox Content="{Binding Loc[LblGpu]}" IsChecked="{Binding GpuEnabled}" Style="{StaticResource ToggleSwitch}"/>
                                            <TextBlock Text="{Binding EngineLabel}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                                            <CheckBox Content="{Binding Loc[LblAudio]}" IsChecked="{Binding AudioEnabled}" Style="{StaticResource ToggleSwitch}"/>
                                            <Button Content="💾 Save Config" Command="{Binding SaveConfigCommand}" Style="{StaticResource ActionButton}" Margin="0,6,0,4"/>
                                            <Button Content="🔴 Record Sequence" Command="{Binding ToggleRecordCommand}" Style="{StaticResource ActionButton}" Margin="0,0,0,4"/>
                                            <Button Content="📷 Export PNG" Command="{Binding ExportCommand}" Style="{StaticResource ActionButton}" Margin="0,0,0,4"/>
                                            <Button Content="{Binding Loc[BtnExportMesh]}" Command="{Binding ExportMeshCommand}" Style="{StaticResource ActionButton}" Margin="0,0,0,4"/>
                                            <Button Content="{Binding Loc[BtnOpenFolder]}" Command="{Binding OpenFolderCommand}" Style="{StaticResource ActionButton}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- 3D ВЬЮПОРТ -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <Grid.Background>
                        <RadialGradientBrush Center="0.5,0.45" RadiusX="0.85" RadiusY="0.85">
                            <GradientStop Color="#FF1B1B3C" Offset="0"/>
                            <GradientStop Color="#FF0D0D1F" Offset="0.55"/>
                            <GradientStop Color="#FF05050B" Offset="1"/>
                        </RadialGradientBrush>
                    </Grid.Background>

                    <helix:HelixViewport3D x:Name="Viewport"
                                           Background="Transparent"
                                           ShowCoordinateSystem="False" ShowViewCube="False"
                                           CameraRotationMode="Turntable"
                                           IsInertiaEnabled="True" IsHeadLightEnabled="True"
                                           RotateGesture="LeftClick" PanGesture="RightClick"
                                           CameraMode="Inspect"
                                           MouseDown="Viewport_MouseDown"
                                           MouseMove="Viewport_MouseMove"
                                           MouseUp="Viewport_MouseUp">

                        <helix:HelixViewport3D.Camera>
                            <PerspectiveCamera Position="0,2.2,9.5" LookDirection="0,-2.2,-9.5"
                                               UpDirection="0,1,0" FieldOfView="42"/>
                        </helix:HelixViewport3D.Camera>

                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <AmbientLight Color="#FF3A3A55"/>
                                    <DirectionalLight Color="#FFFFF4E4" Direction="-0.55,-0.85,-0.75"/>
                                    <DirectionalLight Color="#FF5E78C8" Direction="0.85,0.25,0.55"/>
                                    <DirectionalLight Color="#FF7A4FE0" Direction="0.15,0.6,1.0"/>
                                    <DirectionalLight Color="#FF20304A" Direction="0,-1,0.2"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>

                        <ModelVisual3D x:Name="ModelHost">
                            <ModelVisual3D.Transform>
                                <RotateTransform3D>
                                    <RotateTransform3D.Rotation>
                                        <AxisAngleRotation3D x:Name="SpinRotation" Axis="0,1,0" Angle="0"/>
                                    </RotateTransform3D.Rotation>
                                </RotateTransform3D>
                            </ModelVisual3D.Transform>
                        </ModelVisual3D>
                    </helix:HelixViewport3D>

                    <!-- Предупреждение о нежизнеспособных параметрах -->
                    <Border Style="{StaticResource OverlayBadge}"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            Visibility="{Binding HasViabilityWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ViabilityWarning}" FontSize="11.5"
                                   Foreground="{StaticResource AccentRedBrush}"
                                   FontFamily="{StaticResource UIFont}"/>
                    </Border>

                    <!-- Title badge -->
                    <Border Style="{StaticResource OverlayBadge}"
                            VerticalAlignment="Top" HorizontalAlignment="Left"
                            Visibility="{Binding HudVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧬" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[AppTitle]}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource UIFont}"/>
                                <TextBlock Text="{Binding Loc[AppSubtitle]}" FontSize="10.5"
                                           Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource UIFont}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Step badge -->
                    <Border Style="{StaticResource OverlayBadge}"
                            VerticalAlignment="Top" HorizontalAlignment="Right"
                            Margin="14,14,14,0">
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="14">
                            <Run Text="{Binding Loc[LblStep], Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding CurrentStep, Mode=OneWay, StringFormat=N0}"
                                 Foreground="{StaticResource TextValueBrush}" FontWeight="Bold"/>
                        </TextBlock>
                    </Border>

                    <!-- Phase map + sparkline -->
                    <Border Style="{StaticResource OverlayBadge}"
                            VerticalAlignment="Top" HorizontalAlignment="Right"
                            Margin="14,60,14,0"
                            Visibility="{Binding HudVisibility}">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[LblPearson]}" FontSize="9"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <Canvas Width="120" Height="80" ClipToBounds="True">
                                <Image Canvas.Left="0" Canvas.Top="0" Width="120" Height="80"
                                       Stretch="Fill" Source="{Binding PhaseMap}" Opacity="0.9"/>
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource AccentPrimaryBrush}"
                                         Stroke="White" StrokeThickness="1"
                                         Canvas.Left="{Binding PhasePoint.X, Converter={StaticResource PhaseXConverter}}"
                                         Canvas.Top="{Binding PhasePoint.Y, Converter={StaticResource PhaseYConverter}}"/>
                            </Canvas>
                            <TextBlock Text="{Binding Loc[LblHistory]}" FontSize="9"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,4"/>
                            <Border Width="120" Height="36" Background="#10FFFFFF" ClipToBounds="True">
                                <Polyline Points="{Binding SparklinePoints}"
                                          Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="1.5"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Brush -->
                    <Border Style="{StaticResource OverlayBadge}"
                            VerticalAlignment="Bottom" HorizontalAlignment="Right"
                            Margin="14" Visibility="{Binding HudVisibility}">
                        <StackPanel Width="170">
                            <TextBlock Text="🖌 BRUSH (Shift+Drag)" Style="{StaticResource SectionHeader}"/>
                            <ComboBox ItemsSource="{Binding BrushItems}"
                                      ItemTemplate="{StaticResource LabelItemTemplate}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedBrushTool}"
                                      Style="{StaticResource DarkCombo}"/>
                            <Grid>
                                <TextBlock Text="Size" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Text="{Binding BrushSize, StringFormat=F2}" Style="{StaticResource ParamValueText}"/>
                            </Grid>
                            <Slider Value="{Binding BrushSize}" Minimum="0.01" Maximum="0.2" Style="{StaticResource ModernSlider}"/>
                            <Grid>
                                <TextBlock Text="Strength" Style="{StaticResource ParamLabel}"/>
                                <TextBlock Text="{Binding BrushStrength, StringFormat=F2}" Style="{StaticResource ParamValueText}"/>
                            </Grid>
                            <Slider Value="{Binding BrushStrength}" Minimum="0.05" Maximum="1.0" Style="{StaticResource ModernSlider}"/>
                        </StackPanel>
                    </Border>

                    <!-- Status -->
                    <Border Style="{StaticResource OverlayBadge}"
                            VerticalAlignment="Bottom" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" FontFamily="{StaticResource UIFont}" VerticalAlignment="Center"/>
                            <TextBlock Margin="14,0,0,0" Text="{Binding Fps, StringFormat={}{0:0} FPS}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Margin="14,0,0,0" Text="{Binding StatsText}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Hints -->
                    <Border Style="{StaticResource OverlayBadge}"
                            VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="0,0,0,60" Opacity="0.7"
                            Visibility="{Binding HudVisibility}">
                        <TextBlock Text="{Binding Loc[HintControls]}" FontSize="10.5"
                                   FontFamily="{StaticResource UIFont}"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>